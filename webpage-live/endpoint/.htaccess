# Pass the Authorization header to PHP (Apache + PHP-FPM drops it by default)
CGIPassAuth On
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
# Only index.php is served from here
DirectoryIndex index.php

# Serve /endpoint directly instead of 301-redirecting to /endpoint/ (the redirect
# would be http:// behind the tunnel and would turn POST into GET)
DirectorySlash Off
Options -Indexes
